        'win_percentage_last_10',
        'diff_win_percentage_last_10',
        'win_percentage',
        'diff_win_percentage'
        ]


    X = box_score_df[x_cols]
    y = box_score_df["win"].astype(int)

    X_train, X_test, y_train, y_test = train_test_split(
